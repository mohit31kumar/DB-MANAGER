---
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/mohit31kumar/DB-MANAGER';

const links = [
  { href: base, label: 'Home' },
  { href: `${base}docs`, label: 'Docs' },
  { href: repo, label: 'GitHub', external: true },
];
---

<nav class="nav" data-nav>
  <div class="nav-inner">
    <a class="nav-brand" href={base}>
      <span class="logo">DB</span>
      DB<span class="brand-accent">Manager</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="nav-links"
      aria-label="Toggle navigation menu"
    >
      <Icon name="menu" size={18} />
    </button>

    <div class="nav-links" id="nav-links" data-nav-links data-open="false">
      {
        links.map((l) =>
          l.external ? (
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              data-nav-link
            >
              {l.label}
            </a>
          ) : (
            <a href={l.href} data-nav-link>
              {l.label}
            </a>
          )
        )
      }
      <a class="nav-cta" href={`${base}docs`}>Get Started</a>
    </div>
  </div>

  <div class="nav-progress" data-nav-progress aria-hidden="true"></div>
</nav>